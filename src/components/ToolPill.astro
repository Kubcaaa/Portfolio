---
export interface Props {
  name: string;
  variant?: 'overlay' | 'pill';
}

const { name, variant = 'pill' } = Astro.props;

// Icônes reprises de src/ico/*.svg (rect de fond retiré, tracés conservés).
const icons: Record<string, { viewBox: string; content: string }> = {
