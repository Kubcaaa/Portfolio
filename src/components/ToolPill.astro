    viewBox: '0 0 14 14',
    content:
      '<path d="M 3.08 3.562 C 3.08 3.828 3.298 4.044 3.567 4.044 L 7.603 4.044 C 8.063 4.044 8.442 4.184 8.74 4.465 C 9.038 4.746 9.186 5.108 9.186 5.549 C 9.186 5.958 9.038 6.292 8.74 6.553 C 8.442 6.808 8.063 6.935 7.603 6.935 L 5.849 6.935 C 5.58 6.935 5.362 7.15 5.362 7.417 C 5.362 7.683 5.58 7.898 5.849 7.898 L 7.786 7.898 L 9.531 10.669 C 9.64 10.836 9.792 10.92 9.988 10.92 C 10.205 10.92 10.357 10.836 10.445 10.669 C 10.533 10.495 10.516 10.311 10.394 10.117 L 8.841 7.647 C 9.261 7.46 9.592 7.186 9.836 6.824 C 10.079 6.456 10.201 6.031 10.201 5.549 C 10.201 5.061 10.09 4.633 9.866 4.265 C 9.65 3.896 9.346 3.609 8.953 3.401 C 8.561 3.187 8.111 3.08 7.603 3.08 L 3.567 3.08 C 3.298 3.08 3.08 3.296 3.08 3.562 Z" fill="currentColor" />',
