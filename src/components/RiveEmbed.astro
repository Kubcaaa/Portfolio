---
// Composant générique pour intégrer un fichier .riv (Rive) via @rive-app/webgl.
// On utilise le renderer WebGL (et non @rive-app/canvas) car le vector feathering
// (flous/glows appliqués aux formes dans l'éditeur Rive) n'est rendu que par le
// "Rive Renderer" en WebGL2 — le runtime Canvas 2D l'ignore silencieusement et
// affiche des bords nets à la place.
//
// - src: chemin vers le fichier .riv dans /public/rive
// - stateMachine: nom de la State Machine à piloter (créée dans l'éditeur Rive)
// - hoverInput: nom d'un input booléen de la State Machine à basculer au survol
//   (ex: une input "Hover" que tu crées toi-même dans Rive)
// - autoplay: joue l'animation par défaut au chargement
//
// Note WebGL: les navigateurs limitent le nombre de contextes WebGL actifs en
// même temps par page (souvent ~8-16 selon le GPU/navigateur). Comme le site
// affiche plusieurs Rive dans une liste qui défile, ce composant monte
// l'animation seulement quand sa carte approche du viewport et la détruit
// (rive.cleanup()) quand elle en sort, pour ne jamais dépasser cette limite.

export interface Props {
  src: string;
  stateMachine?: string;
  hoverInput?: string;
  autoplay?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  src,
  stateMachine,
  hoverInput,
  autoplay = true,
  ariaLabel = 'Animation',
  class: className = '',
} = Astro.props;

const uid = `rive-${Math.random().toString(36).slice(2, 9)}`;
---

<canvas
  id={uid}
  data-rive-src={src}
  data-rive-state-machine={stateMachine}
  data-rive-hover-input={hoverInput}
  data-rive-autoplay={String(autoplay)}
  role="img"
  aria-label={ariaLabel}
  class={`block h-full w-full ${className}`}
></canvas>

<script>
  import { Rive, Layout, Fit, Alignment } from '@rive-app/webgl';

  type RiveInstance = InstanceType<typeof Rive>;

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  function mountRive(canvas: HTMLCanvasElement): RiveInstance | null {
    const src = canvas.dataset.riveSrc;
    if (!src) return null;

    const stateMachines = canvas.dataset.riveStateMachine
      ? [canvas.dataset.riveStateMachine]
      : undefined;
    const hoverInputName = canvas.dataset.riveHoverInput;
    const autoplay = canvas.dataset.riveAutoplay !== 'false';

    const rive = new Rive({
      src,
      canvas,
      autoplay,
      stateMachines,
      layout: new Layout({ fit: Fit.Cover, alignment: Alignment.Center }),
      onLoad: () => {
        rive.resizeDrawingSurfaceToCanvas();
      },
    });

    // Bascule un input booléen de la State Machine au survol de la zone parente
    // (utile pour les aperçus de projet: la carte entière déclenche l'animation)
    if (hoverInputName && stateMachines) {
      const zone =
        (canvas.closest('[data-rive-hover-zone]') as HTMLElement | null) ??
        canvas.parentElement;

      const setHover = (value: boolean) => {
        try {
          const inputs = rive.stateMachineInputs(stateMachines[0]);
          const input = inputs?.find((i) => i.name === hoverInputName);
          if (input) input.value = value;
        } catch {
          // la State Machine n'est pas encore prête, on ignore silencieusement
        }
      };

      zone?.addEventListener('mouseenter', () => setHover(true));
      zone?.addEventListener('mouseleave', () => setHover(false));
    }

    const resize = () => rive.resizeDrawingSurfaceToCanvas();
    window.addEventListener('resize', resize);

    return rive;
  }

  document
    .querySelectorAll<HTMLCanvasElement>('canvas[data-rive-src]')
    .forEach((canvas) => {
      if (prefersReducedMotion) {
        // On respecte la préférence utilisateur: pas de lecture automatique.
        // Tu peux remplacer ceci par une image statique de repli si besoin.
        return;
      }

      let rive: RiveInstance | null = null;

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && !rive) {
              rive = mountRive(canvas);
            } else if (!entry.isIntersecting && rive) {
              // Libère le contexte WebGL tant que la carte est hors-écran.
              rive.cleanup();
              rive = null;
            }
          }
        },
        { rootMargin: '200px' }
      );

      observer.observe(canvas);
    });
</script>
