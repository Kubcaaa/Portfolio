---
// Composant générique pour intégrer un fichier .riv (Rive) via @rive-app/webgl2.
// On utilise ce renderer (et non @rive-app/canvas) car le vector feathering
// (flous/glows appliqués aux formes dans l'éditeur Rive) n'est rendu que par le
// "Rive Renderer" — le runtime Canvas 2D ne le supporte pas encore.
// Note: @rive-app/webgl (sans le "2") est déprécié depuis la v2.37.0, il ne
// faut surtout pas l'utiliser — c'est le piège dans lequel on est tombé une fois.
//
// - src: chemin vers le fichier .riv dans /public/rive
// - stateMachine: nom EXACT d'une State Machine à cibler en particulier (optionnel).
//   Si tu ne le passes pas, le composant détecte automatiquement TOUTES les
//   State Machines présentes dans le fichier et les active — donc les Listeners
//   et interactions que tu as configurés dans l'éditeur Rive fonctionnent sans
//   que tu aies à connaître ou taper leur nom exact ici.
// - hoverInput: nom d'un input booléen à basculer au survol (cherché dans
//   toutes les State Machines actives si `stateMachine` n'est pas précisé)
// - autoplay: joue l'animation par défaut au chargement
//
// Note WebGL: les navigateurs limitent le nombre de contextes WebGL actifs en
// même temps par page (souvent ~8-16 selon le GPU/navigateur). Comme le site
// affiche plusieurs Rive dans une liste qui défile, ce composant monte
// l'animation seulement quand sa carte approche du viewport et la détruit
// (rive.cleanup()) quand elle en sort, pour ne jamais dépasser cette limite.

export interface Props {
  src: string;
  stateMachine?: string;
  hoverInput?: string;
  autoplay?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  src,
  stateMachine,
  hoverInput,
  autoplay = true,
  ariaLabel = 'Animation',
  class: className = '',
} = Astro.props;

const uid = `rive-${Math.random().toString(36).slice(2, 9)}`;
---

<canvas
  id={uid}
  data-rive-src={src}
  data-rive-state-machine={stateMachine}
  data-rive-hover-input={hoverInput}
  data-rive-autoplay={String(autoplay)}
  role="img"
  aria-label={ariaLabel}
  class={`block h-full w-full ${className}`}
></canvas>

<script>
  import { Rive, Layout, Fit, Alignment } from '@rive-app/webgl2';

  type RiveInstance = InstanceType<typeof Rive>;

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  function mountRive(canvas: HTMLCanvasElement): RiveInstance | null {
    const src = canvas.dataset.riveSrc;
    if (!src) return null;

    // Si un nom précis est fourni, on cible uniquement celui-là. Sinon on laisse
    // `stateMachines` vide au chargement et on activera TOUT ce qu'on trouve
    // une fois le fichier chargé (voir onLoad plus bas) — ça marche quel que
    // soit le nom réel donné à la State Machine dans l'éditeur Rive.
    const explicitStateMachine = canvas.dataset.riveStateMachine || undefined;
    const hoverInputName = canvas.dataset.riveHoverInput;
    const autoplay = canvas.dataset.riveAutoplay !== 'false';

    const rive = new Rive({
      src,
      canvas,
      autoplay,
      stateMachines: explicitStateMachine ? [explicitStateMachine] : undefined,
      useOffscreenRenderer: true,
      layout: new Layout({ fit: Fit.Cover, alignment: Alignment.Center }),
      onLoad: () => {
        rive.resizeDrawingSurfaceToCanvas();

        // Aucun nom précis fourni: on découvre les State Machines du fichier
        // et on les joue toutes, pour activer Listeners/transitions sans avoir
        // besoin de connaître leur nom exact à l'avance.
        if (!explicitStateMachine) {
          const names = rive.stateMachineNames;
          if (names && names.length > 0) {
            rive.play(names);
          }
        }
      },
    });

    // Bascule un input booléen au survol de la zone parente (utile pour les
    // aperçus de projet: la carte entière déclenche l'animation). On cherche
    // l'input dans la State Machine ciblée si elle est précisée, sinon dans
    // toutes les State Machines actives du fichier.
    if (hoverInputName) {
      const zone =
        (canvas.closest('[data-rive-hover-zone]') as HTMLElement | null) ??
        canvas.parentElement;

      const setHover = (value: boolean) => {
        try {
          const names = explicitStateMachine
            ? [explicitStateMachine]
            : rive.stateMachineNames;
          for (const name of names ?? []) {
            const inputs = rive.stateMachineInputs(name);
            const input = inputs?.find((i) => i.name === hoverInputName);
            if (input) input.value = value;
          }
        } catch {
          // la State Machine n'est pas encore prête, on ignore silencieusement
        }
      };

      zone?.addEventListener('mouseenter', () => setHover(true));
      zone?.addEventListener('mouseleave', () => setHover(false));
    }

    const resize = () => rive.resizeDrawingSurfaceToCanvas();
    window.addEventListener('resize', resize);

    return rive;
  }

  document
    .querySelectorAll<HTMLCanvasElement>('canvas[data-rive-src]')
    .forEach((canvas) => {
      if (prefersReducedMotion) {
        // On respecte la préférence utilisateur: pas de lecture automatique.
        // Tu peux remplacer ceci par une image statique de repli si besoin.
        return;
      }

      let rive: RiveInstance | null = null;

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && !rive) {
              rive = mountRive(canvas);
            } else if (!entry.isIntersecting && rive) {
              // Libère le contexte WebGL tant que la carte est hors-écran.
              rive.cleanup();
              rive = null;
            }
          }
        },
        { rootMargin: '200px' }
      );

      observer.observe(canvas);
    });
</script>
