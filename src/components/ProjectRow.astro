---
import RiveEmbed from './RiveEmbed.astro';
import ToolPill from './ToolPill.astro';
import type { Project } from '../data/projects';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const isExternal = project.href.startsWith('http');
---

<a
  href={project.href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noreferrer' : undefined}
  class="group mb-16 block last:mb-0"
>
  <!--
    min-height = hauteur de secours affichée avant que le .riv soit chargé
    (évite un saut de mise en page). Une fois chargé, RiveEmbed applique le
    ratio natif réel de l'artwork au conteneur, qui prend le dessus.
  -->
  <div
    class="w-full overflow-hidden rounded-2xl bg-ink/[0.03]"
    style={`min-height: ${project.riveHeight}px`}
  >
    {
      project.riveHover ? (
        <RiveEmbed
          src={project.riveHover}
          artboard={project.riveArtboard}
          stateMachine={project.riveStateMachine}
          ariaLabel={project.title}
        />
      ) : (
        <img
          src={project.cover}
          alt={project.title}
          loading="lazy"
          class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
        />
      )
    }
  </div>

  <div class="mt-4 flex flex-wrap gap-2">
    {project.tools.map((tool) => <ToolPill name={tool} variant="pill" />)}
  </div>
</a>
