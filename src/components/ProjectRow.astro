---
import RiveEmbed from './RiveEmbed.astro';
import ToolPill from './ToolPill.astro';
import type { Project } from '../data/projects';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const isExternal = project.href.startsWith('http');
// Un lien '#' provoque un saut en haut de page au clic — tant qu'il n'y a
// pas de vraie URL, on omet complètement l'attribut href (l'élément garde
// son style de carte cliquable/hover, mais ne déclenche aucune navigation).
const href = project.href === '#' ? undefined : project.href;
---

<a
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noreferrer' : undefined}
  class="group relative mb-16 block last:mb-0"
  data-rive-hover-zone
>
  <!--
    aspect-ratio (pas min-height!) = ratio de secours générique avant que le
    .riv soit chargé. Un min-height fixe casserait le rendu en dessous de la
    largeur pour laquelle il a été pensé: sur mobile, la hauteur "réelle" du
    ratio devient plus petite que ce min-height, la boîte reste forcée trop
    haute, et Fit: Cover zoome/rogne les côtés pour compenser. Avec
    aspect-ratio, la hauteur suit toujours proportionnellement la largeur,
    à toutes les tailles d'écran. RiveEmbed remplace ce ratio générique par
    le vrai ratio de l'artwork dès que le fichier est chargé.
  -->
  <div class="w-full overflow-hidden rounded-2xl bg-ink/[0.03]" style="aspect-ratio: 4 / 3">
    {
      project.riveHover ? (
        <RiveEmbed
          src={project.riveHover}
          artboard={project.riveArtboard}
          stateMachine={project.riveStateMachine}
          ariaLabel={project.title}
        />
      ) : (
        <img
          src={project.cover}
          alt={project.title}
          loading="lazy"
          class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
        />
      )
    }

    <div class="pointer-events-none absolute bottom-4 left-4 flex flex-wrap gap-2">
      {project.tools.map((tool) => <ToolPill name={tool} variant="overlay" />)}
    </div>
  </div>
</a>
