---
import RiveEmbed from './RiveEmbed.astro';
import ToolPill from './ToolPill.astro';
import type { Project } from '../data/projects';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const isExternal = project.href.startsWith('http');
---

<a
  href={project.href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noreferrer' : undefined}
  class="group relative mb-16 block last:mb-0"
>
  <div class="relative aspect-[4/3] w-full overflow-hidden rounded-2xl bg-ink/[0.03]">
    {
      project.riveHover ? (
        <RiveEmbed
          src={project.riveHover}
          stateMachine="State Machine 1"
          ariaLabel={project.title}
        />
      ) : (
        <img
          src={project.cover}
          alt={project.title}
          loading="lazy"
          class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
        />
      )
    }

    <div class="pointer-events-none absolute bottom-4 left-4 flex flex-wrap gap-2">
      {project.tools.map((tool) => <ToolPill name={tool} variant="overlay" />)}
    </div>
  </div>
</a>
