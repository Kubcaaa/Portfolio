---
import CategoryPill from './CategoryPill.astro';

const expertiseRow1 = ['Branding', 'Web', 'Print'];
const expertiseRow2 = ['Interactive design', 'UI'];
const socials = [
  { label: 'X', href: 'https://x.com/kubca' },
  { label: 'Dribbble', href: 'https://dribbble.com/kubca' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/charles-sage-kubca/' },
];
---

<aside
  class="flex flex-col justify-between px-6 py-10 xs:px-10 lg:sticky lg:top-0 lg:h-screen lg:w-[42%] lg:shrink-0 lg:py-14"
>
  <div>
    <a href="/" class="font-display text-lg font-semibold tracking-tightest">
      KUBCA<span class="text-flare">.</span>
    </a>

    <div class="mt-16 max-w-md">
      <p class="eyebrow mb-6">Design & animation — basé à Lisbonne</p>

      <h1
        class="font-display text-4xl font-semibold leading-[0.95] tracking-tightest md:text-5xl"
      >
        I make brands
        <br /> move, smile,
        <br />&amp; be remembered
      </h1>

      <p class="mt-8 font-body text-base leading-relaxed text-muted">
        Je suis Charles Sage. Je conçois des identités visuelles, des
        interactions et des animations pour le web, le print et au-delà —
        toujours aussi excité de donner vie à de nouvelles idées.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      {expertiseRow1.map((item) => <CategoryPill name={item} />)}
    </div>
    <div class="mt-3 flex flex-wrap gap-3">
      {expertiseRow2.map((item) => <CategoryPill name={item} />)}
    </div>
  </div>

  <div class="mt-16 lg:mt-0">
    <a
      href="mailto:charles@kubca.com"
      class="font-mono text-sm uppercase tracking-widest2 text-flare underline decoration-2 underline-offset-4"
    >
      charles@kubca.com
    </a>
    <nav class="mt-6 flex gap-6 font-mono text-[11px] uppercase tracking-widest2 text-muted">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noreferrer" class="transition hover:text-flare">
          {s.label}
        </a>
      ))}
    </nav>
    <p class="mt-8 font-mono text-[11px] uppercase tracking-widest2 text-muted">
      © {new Date().getFullYear()} Charles Sage
    </p>
  </div>
</aside>
